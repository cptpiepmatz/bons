{
  "tasks": {
    "dev": {
      "description": "Run frontend and backend development servers",
      "command": "deno task dev:*"
    },
    "dev:frontend": {
      "description": "Run the Vite development server",
      "command": "deno run -A vite --host 127.0.0.1",
      "dependencies": ["build:categories"]
    },
    "dev:backend": {
      "description": "Prepare the database and run the backend",
      "command": "cargo run -- serve",
      "dependencies": ["db:prepare"]
    },
    "build": {
      "description": "Build the application",
      "dependencies": ["build:backend"]
    },
    "build:backend": {
      "description": "Build the Rust backend",
      "command": "cargo build",
      "dependencies": ["build:frontend", "db:prepare"]
    },
    "build:bindings": {
      "description": "Build the Rust-Typescript bindings",
      "command": "cargo test export_bindings",
      "dependencies": ["db:prepare"]
    },
    "build:frontend": {
      "description": "Build the frontend assets",
      "command": "deno run -A vite build",
      "dependencies": ["build:bindings", "build:categories"]
    },
    "build:categories": {
      "description": "Generate runtime categories and translations from the bindings",
      "command": "deno run -P=tools tools/generate_categories.ts",
      "dependencies": ["build:bindings"]
    },
    "db:version": {
      "description": "Check that sqlx-cli is installed",
      "command": "cargo sqlx --version"
    },
    "db:setup": {
      "description": "Create the database and run migrations",
      "command": "cargo sqlx database setup --source backend/migrations -D sqlite://target/sqlx.sqlite",
      "dependencies": ["dir:target", "db:version"]
    },
    "db:prepare": {
      "description": "Prepare SQLx query metadata",
      "command": "cargo sqlx prepare -D sqlite://target/sqlx.sqlite",
      "dependencies": ["db:version", "db:setup"]
    },
    "test": {
      "description": "Run frontend and backend tests",
      "command": "deno task test:*"
    },
    "test:frontend": {
      "description": "Run frontend tests",
      "command": "deno test --allow-read --allow-env",
      "dependencies": ["build:frontend"]
    },
    "test:backend": {
      "description": "Run backend tests",
      "command": "cargo test"
    },
    "fmt": {
      "description": "Format all project files",
      "command": "deno task fmt:*"
    },
    "fmt:deno": {
      "description": "Format Deno, frontend, and config files",
      "command": "deno fmt",
      "dependencies": ["fmt:imports"]
    },
    "fmt:imports": {
      "description": "Format TypeScript and Vue imports",
      "command": "deno run --allow-read --allow-write --allow-env @primp/primp/cli frontend tools vite.config.ts primp.config.ts -r"
    },
    "fmt:cargo": {
      "description": "Format Rust code",
      "command": "cargo fmt"
    },
    "fmt:sql": {
      "description": "Format SQL files",
      "command": "deno run -P=tools tools/fmt_sql.ts"
    },
    "preview": {
      "description": "Preview the production frontend build",
      "command": "deno run -A vite preview --host 127.0.0.1"
    },
    "dir:target": {
      "description": "Ensure the `target` dir is available",
      "command": "mkdir -p target"
    }
  },
  "imports": {
    "@fontsource-variable/inter": "npm:@fontsource-variable/inter@^5.3.0",
    "@huggingface/transformers": "npm:@huggingface/transformers@^4.3.1",
    "@phosphor-icons/vue": "npm:@phosphor-icons/vue@^2.2.1",
    "@primp/primp": "jsr:@primp/primp@2.0.0-rc.1",
    "@primp/vue": "jsr:@primp/vue@2.0.0-rc.1",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@6.0.9",
    "bulma": "npm:bulma@1.0.4",
    "dayjs": "npm:dayjs@^1.11.23",
    "sass-embedded": "npm:sass-embedded@1.105.0",
    "sql-formatter": "npm:sql-formatter@^15.9.0",
    "ts-morph": "npm:ts-morph@^28.0.0",
    "vite": "npm:vite@8.3.1",
    "vue": "npm:vue@3.5.43",
    "vue-router": "npm:vue-router@^5.3.1"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"]
  },
  "fmt": {
    "exclude": [
      "target",
      "dist",
      "node_modules",
      "logo",
      "bindings",
      "frontend/generated"
    ]
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "deny": [
      "npm:protobufjs",
      "npm:onnxruntime-node"
    ]
  },
  "permissions": {
    "tools": {
      "read": true,
      "write": true,
      "env": true
    }
  },
  "unstable": ["fmt-component"]
}
