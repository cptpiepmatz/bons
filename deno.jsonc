{
  "tasks": {
    "dev": {
      "command": "deno task dev:*"
    },
    "dev:frontend": "deno run -A vite --host 127.0.0.1",
    "dev:backend": {
      "command": "cargo run",
      "dependencies": ["db:prepare"]
    },
    "build": {
      "dependencies": ["build:backend"]
    },
    "build:backend": {
      "command": "cargo build",
      "dependencies": ["build:frontend"]
    },
    "build:frontend": {
      "command": "deno run -A vite build"
    },
    "db:version": "cargo sqlx --version",
    "db:setup": {
      "command": "cargo sqlx database setup --source backend/migrations -D sqlite://target/sqlx.sqlite",
      "dependencies": ["db:version"]
    },
    "db:prepare": {
      "command": "cargo sqlx prepare -D sqlite://target/sqlx.sqlite",
      "dependencies": ["db:version", "db:setup"]
    },
    "fmt": "deno task fmt:*",
    "fmt:deno": "deno fmt",
    "fmt:cargo": "cargo fmt",
    "fmt:sql": "deno run -P=tools tools/fmt_sql.ts",
    "preview": "deno run -A vite preview --host 127.0.0.1"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@6.0.1",
    "bulma": "npm:bulma@1.0.4",
    "sass-embedded": "npm:sass-embedded@1.90.0",
    "sql-formatter": "npm:sql-formatter@^15.8.2",
    "vite": "npm:vite@7.1.4",
    "vue": "npm:vue@3.5.21"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"]
  },
  "fmt": {
    "exclude": ["target", "dist", "node_modules"]
  },
  "nodeModulesDir": "auto",
  "permissions": {
    "tools": {
      "read": true,
      "write": true
    }
  }
}
