{
  "tasks": {
    "dev": {
      "description": "Run frontend and backend development servers",
      "command": "deno task dev:*"
    },
    "dev:frontend": {
      "description": "Run the Vite development server",
      "command": "deno run -A vite --host 127.0.0.1"
    },
    "dev:backend": {
      "description": "Prepare the database and run the backend",
      "command": "cargo run",
      "dependencies": ["db:prepare"]
    },
    "build": {
      "description": "Build the application",
      "dependencies": ["build:backend"]
    },
    "build:backend": {
      "description": "Build the Rust backend",
      "command": "cargo build",
      "dependencies": ["build:frontend", "db:prepare"]
    },
    "build:frontend": {
      "description": "Build the frontend assets",
      "command": "deno run -A vite build"
    },
    "db:version": {
      "description": "Check that sqlx-cli is installed",
      "command": "cargo sqlx --version"
    },
    "db:setup": {
      "description": "Create the database and run migrations",
      "command": "cargo sqlx database setup --source backend/migrations -D sqlite://target/sqlx.sqlite",
      "dependencies": ["dir:target", "db:version"]
    },
    "db:prepare": {
      "description": "Prepare SQLx query metadata",
      "command": "cargo sqlx prepare -D sqlite://target/sqlx.sqlite",
      "dependencies": ["db:version", "db:setup"]
    },
    "fmt": {
      "description": "Format all project files",
      "command": "deno task fmt:*"
    },
    "fmt:deno": {
      "description": "Format Deno, frontend, and config files",
      "command": "deno fmt"
    },
    "fmt:cargo": {
      "description": "Format Rust code",
      "command": "cargo fmt"
    },
    "fmt:sql": {
      "description": "Format SQL files",
      "command": "deno run -P=tools tools/fmt_sql.ts"
    },
    "preview": {
      "description": "Preview the production frontend build",
      "command": "deno run -A vite preview --host 127.0.0.1"
    },
    "dir:target": {
      "description": "Ensure the `target` dir is available",
      "command": "mkdir -p target"
    }
  },
  "imports": {
    "@fontsource-variable/inter": "npm:@fontsource-variable/inter@^5.3.0",
    "@phosphor-icons/vue": "npm:@phosphor-icons/vue@^2.2.1",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@6.0.1",
    "bulma": "npm:bulma@1.0.4",
    "dayjs": "npm:dayjs@^1.11.23",
    "sass-embedded": "npm:sass-embedded@1.90.0",
    "sql-formatter": "npm:sql-formatter@^15.8.2",
    "vite": "npm:vite@7.1.4",
    "vue": "npm:vue@3.5.21",
    "vue-router": "npm:vue-router@^4.5.1"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"]
  },
  "fmt": {
    "exclude": ["target", "dist", "node_modules", "logo"]
  },
  "nodeModulesDir": "auto",
  "permissions": {
    "tools": {
      "read": true,
      "write": true
    }
  },
  "unstable": ["fmt-component"]
}
